                  ]
                }
              ]
            },
            {
              "type": "frame",
              "id": "n3kxq",
              "name": "s10notes",
              "layout": "vertical",
              "gap": 6,
              "children": [
                {
                  "type": "text",
                  "id": "BJxl8",
                  "fill": "#64748B",
                  "content": "• All components use CSS variable tokens — zero hardcoded colors",
                  "fontFamily": "Inter",
                  "fontSize": 12,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "BDy4n",
                  "fill": "#64748B",
                  "content": "• Toggle UI: Settings page → Appearance section → Select dropdown (Light / Dark / System)",
                  "fontFamily": "Inter",
                  "fontSize": 12,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "HCM0n",
                  "fill": "#64748B",
                  "content": "• Provider: Alpine.js global store ('theme') wraps toggle logic. Persists to localStorage('scribe-theme'). Respects OS via matchMedia('prefers-color-scheme: dark').",
                  "fontFamily": "Inter",
                  "fontSize": 12,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "fo5D9",
                  "fill": "#64748B",
                  "content": "• Jinja2 implementation: base.html sets initial class server-side via inline <script> (prevents flash). Alpine hydrates after load.",
                  "fontFamily": "Inter",
                  "fontSize": 12,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "rEuD9",
                  "fill": "#64748B",
                  "content": "• Status indicator foreground colors (green, blue, red, amber) stay constant — only their backgrounds darken",
                  "fontFamily": "Inter",
                  "fontSize": 12,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "text",
              "id": "rmvgK",
              "name": "s10note",
              "fill": "#94A3B8",
              "content": "The design inverts surfaces and text while keeping accent green and status colors constant. This ensures brand identity and status readability are preserved across themes. Engineers: use Tailwind semantic tokens (bg-background, text-foreground, etc.) — never hardcode hex values.",
              "fontFamily": "Inter",
              "fontSize": 11,
              "fontWeight": "normal",
              "fontStyle": "italic"
            },
