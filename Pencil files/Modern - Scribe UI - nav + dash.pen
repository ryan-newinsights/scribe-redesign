          "children": [
            {
              "type": "frame",
              "id": "6fzaf",
              "name": "s-typography",
              "width": "fill_container",
              "fill": "#F8FAFC",
              "cornerRadius": 8,
              "stroke": "#E2E8F0",
              "strokeWidth": 1,
